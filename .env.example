# ─────────────────────────────────────────────────────────
# VoxCampus — Environment Variables
# Copy this file to .env and fill in your credentials
# NEVER commit the .env file to version control
# ─────────────────────────────────────────────────────────

# App
SECRET_KEY=your-secret-key-change-this-in-production

# ── Azure AI Speech ───────────────────────────────────────
AZURE_SPEECH_KEY=your-azure-speech-subscription-key
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_LANGUAGE=en-US
AZURE_TTS_VOICE=en-US-JennyNeural

# ── Azure AI Search (RAG — optional but recommended) ──────
# Leave blank to use local TF-IDF RAG (works without Azure Search)
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_KEY=your-azure-search-admin-key
AZURE_SEARCH_INDEX_NAME=voxcampus-knowledge

# Azure OpenAI Embeddings (for vector search in Azure AI Search)
# Uses the same Azure OpenAI resource as Foundry
AZURE_EMBEDDINGS_DEPLOYMENT=text-embedding-ada-002

# ── Microsoft Foundry AI Agent ────────────────────────────
# Option A: Foundry Agent (preferred)
FOUNDRY_PROJECT_CONNECTION_STRING=your-foundry-project-connection-string
FOUNDRY_AGENT_ID=your-foundry-agent-id

# Option B: Azure OpenAI fallback (used if Agent not configured)
AZURE_FOUNDRY_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_FOUNDRY_API_KEY=your-azure-openai-api-key
AZURE_FOUNDRY_DEPLOYMENT=gpt-4o
AZURE_FOUNDRY_API_VERSION=2024-02-01

# ── Database ──────────────────────────────────────────────
# Default: SQLite (no setup needed)
DATABASE_URL=sqlite:///./voxcampus.db
